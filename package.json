{
  "name": "ts-pnpm-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "lint": "biome check --error-on-warnings .",
    "fix": "biome check --write --error-on-warnings . && pnpm knip:fix",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test:ci && pnpm depcruise && pnpm knip && pnpm dupcheck",
    "danger:ci": "tsc --ignoreConfig dangerfile.ts --module nodenext --target es2024 --skipLibCheck --outDir node_modules/.cache/danger && danger ci --dangerfile node_modules/.cache/danger/dangerfile.js",
    "prepare": "husky",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "depcruise": "depcruise --config .dependency-cruiser.ts src",
    "dupcheck": "jscpd src",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@swc/core": "^1.16.13",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "danger": "^14.0.7",
    "dependency-cruiser": "^18.5.0",
    "husky": "^9.1.7",
    "jscpd": "^5.4.0",
    "knip": "^6.39.0",
    "lint-staged": "^17.6.0",
    "tsc-alias": "^1.9.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45"
}
